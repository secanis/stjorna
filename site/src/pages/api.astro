---
// Standalone Swagger UI page. Loads the vendored bundle/CSS from
// ../swagger-ui/ and the live spec from ../openapi.json, so relative paths
// keep working whether the site is served from a subpath or a root domain.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>STJÓRNA — API reference</title>
    <meta name="description" content="Interactive OpenAPI 3.0 reference for the STJÓRNA REST API." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/swagger-ui/swagger-ui.css" />
    <style>
      body { margin: 0; }
      .topbar {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.65rem 1.25rem;
        background: #0f172a;
        border-bottom: 1px solid #1e293b;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .topbar a {
        color: #7dd3fc;
        text-decoration: none;
        font-size: 0.9rem;
      }
      .topbar a:hover { color: #e2e8f0; }
      .topbar .brand {
        color: #f1f5f9;
        font-weight: 600;
        margin-right: auto;
      }
    </style>
  </head>
  <body>
    <div class="topbar">
      <span class="brand">STJÓRNA — API reference</span>
      <a href="/">Home</a>
      <a href="/docs/">Docs</a>
      <a href="/openapi.json" target="_blank">openapi.json</a>
    </div>
    <div id="swagger-ui"></div>
    <script src="/swagger-ui/swagger-ui-bundle.js" is:inline></script>
    <script>
      window.onload = () => {
        window.ui = SwaggerUIBundle({
          url: '/openapi.json',
          dom_id: '#swagger-ui',
          deepLinking: true,
          presets: [SwaggerUIBundle.presets.apis],
          layout: 'BaseLayout',
        });
      };
    </script>
  </body>
</html>
