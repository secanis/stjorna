# STJÓRNA — environment configuration
# Copy to .env and fill in the values. All vars are optional unless noted.

# ============================================
# PocketBase
# ============================================
# Encryption key for PocketBase's internal data. PocketBase uses
# PB_SECRET directly as the AES-256 key, so it MUST be exactly 32
# ASCII characters. A 64-character hex value (from `openssl rand -hex 32`)
# would silently disable encryption — the container now refuses to start
# in that state (T-07).
#
# Generate a fresh key (32 chars):
#   openssl rand -hex 16
#   openssl rand -base64 32 | tr -d '=+/' | head -c 32
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
PB_SECRET=your-generated-secret-here

# ============================================
# Storage
# ============================================
# Default: files are stored inside the PocketBase container at pb_data/storage/.
# For production, mount ./pocketbase/pb_data as a host volume to persist data.
#
# S3 storage is configured through the setup wizard (stored in PocketBase's
# settings table, not via env vars). PB v0.22.7 does not support S3 env vars.
# After completing the wizard, S3 is active immediately — no restart needed.
#
# To switch storage later, use the PocketBase Admin UI:
#   Settings → Files storage → S3 (toggle enabled and fill in credentials)
#
# For PB v0.23+ (not the version shipped with this Dockerfile), the env vars
# PB_STORAGE_S3_BUCKET / PB_STORAGE_S3_REGION / PB_STORAGE_S3_ENDPOINT /
# PB_STORAGE_S3_ACCESS_KEY / PB_STORAGE_S3_SECRET / PB_STORAGE_S3_FORCE_PATH_STYLE
# can be set before starting PB to seed the settings table on first run.

# ============================================
# Development / testing
# ============================================
# When SMTP is not configured, log generated superuser OTP codes to the
# PocketBase stdout/logs so they can be copied manually. Accepted values:
# "1", "true" or "yes". Leave empty or unset to disable.
# NEVER enable this in production — OTP codes are authentication secrets.
# STJORNA_LOG_OTP=1

# ============================================
# Traefik (for production)
# ============================================
# DOMAIN=stjorna.example.com
