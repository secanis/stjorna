# Patterns to ignore when building Helm packages.
.DS_Store
.git/
.gitignore
.bzr/
.hg/
.svn/
*.tmproj
.idea/
.vscode/
*.swp
*.bak
README.md.gotmpl
# NOTE: '*.tgz' and 'charts/' are intentionally NOT ignored here.
# helm's .helmignore rules also apply when LOADING a chart (not just
# when packaging it), so excluding 'charts/*.tgz' prevents the loader
# from seeing vendored dependency charts and 'helm package' / 'cr
# package' then fail with "found in Chart.yaml, but missing in charts/
# directory: <dep>". We don't keep stray .tgz files in this chart dir,
# so the broader exclude is unnecessary.
