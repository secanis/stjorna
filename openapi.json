{"openapi":"3.0.3","info":{"title":"STJÓRNA API","description":"Multi-tenant product management API (PocketBase). Three tiers derived from the live collection API rules: Public (no auth), Private (authenticated user; the rule restricts records to the caller's tenants), Admin (PocketBase superusers only).","version":"3.0.0","contact":{"name":"STJÓRNA"}},"servers":[{"url":"/api","description":"PocketBase API root"}],"tags":[{"name":"Public","description":"No authentication required"}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"},"apiKey":{"type":"http","scheme":"bearer","description":"STJÓRNA API key (stjorna_<prefix>.<secret>)"}},"schemas":{"Error":{"type":"object","properties":{"status":{"type":"integer"},"message":{"type":"string"},"data":{"type":"object"}}},"User":{"type":"object","properties":{"id":{"type":"string","readOnly":true},"email":{"type":"string","format":"email"},"emailVisibility":{"type":"boolean"},"verified":{"type":"boolean"},"name":{"type":"string"},"avatar":{"type":"string","description":"File name (upload via multipart/form-data)"},"created":{"type":"string","description":"Date-time, \"YYYY-MM-DD HH:MM:SS.sssZ\"","readOnly":true},"updated":{"type":"string","description":"Date-time, \"YYYY-MM-DD HH:MM:SS.sssZ\"","readOnly":true},"last_tenant":{"type":"string"}}}},"parameters":{"Page":{"name":"page","in":"query","schema":{"type":"integer","default":1}},"PerPage":{"name":"perPage","in":"query","schema":{"type":"integer","default":30}},"Filter":{"name":"filter","in":"query","schema":{"type":"string"}},"Sort":{"name":"sort","in":"query","schema":{"type":"string"}},"Expand":{"name":"expand","in":"query","schema":{"type":"string"}},"Fields":{"name":"fields","in":"query","schema":{"type":"string"}}},"responses":{"Unauthorized":{"description":"Missing or invalid auth token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Forbidden":{"description":"Authenticated but n