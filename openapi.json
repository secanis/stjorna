 the one-time setup token (STJORNA_SETUP_TOKEN env var or the token printed in the server log) in the X-Stjorna-Setup-Token header. Refuses once a superuser exists or setup is done.","parameters":[{"name":"X-Stjorna-Setup-Token","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string"},"password":{"type":"string"},"passwordConfirm":{"type":"string"}},"required":["email","password","passwordConfirm"]}}}},"responses":{"200":{"description":"Superuser created","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"id":{"type":"string"},"email":{"type":"string"}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"409":{"description":"A superuser already exists or setup is already done"}}}},"/stjorna/oidc-config":{"get":{"tags":["Public"],"summary":"Public OIDC login configuration for the login page (no secrets).","responses":{"200":{"description":"OIDC login configuration","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/stjorna/api-keys/me":{"get":{"tags":["Public"],"summary":"Introspect the bearer API key (Authorization: Bearer stjorna_…).","security":[{"apiKey":[]}],"responses":{"200":{"description":"Tenant + metadata for the verified key","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"tenant":{"type":"string"},"id":{"type":"string"},"prefix":{"type":"string"},"permissions":{"type":"object"},"expires":{"type":"integer","nullable":true,"description":"Epoch ms"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}}},"/stjorna/api-keys/exchange":{"post":{"tags":["Public"],"summary":"Exchange an API key (Authorization: Bearer or JSON {key}) for a short-lived, non-refreshable user JWT of the key's service user. Use the JWT for /api/collections/* requests.","security":[{"apiKey":