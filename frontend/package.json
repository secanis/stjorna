{
  "name": "stjorna-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --mode remote",
    "build": "node scripts/generate-version.mjs && vite build",
    "build:remote": "node scripts/generate-version.mjs && vite build --mode remote",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:fast": "playwright test"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-query": "^5.62.16",
    "lucide-solid": "^1.21.0",
    "pocketbase": "^0.21.0",
    "solid-js": "^1.9.3",
    "swagger-ui-dist": "^5.32.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/pngjs": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.7"
  }
}
